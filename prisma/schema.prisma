generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URI")
}

model Task {
  id String @id @default(uuid())

  title String
  description String?
  note Int
  rating Float @default(0.0)
  isAvailable Boolean @default(false) @map("is_available")
  genre Genre @default(FAST)

  reviews Review[] @relation("task_reviews")
  executor Executor[] @relation("task_executors")

  poster Poster @relation(fields: [posterId], references: [id])
  posterId String @unique

  cretedAt DateTime @default(now()) @map("creted_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("task")
}

model Review {
  id String @id @default(uuid())

  text String 
  task Task @relation("task_reviews", fields: [taskId], references: [id], onDelete: Cascade)
  taskId String @map("task_id")
  
  cretedAt DateTime @default(now()) @map("creted_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("reviews")
}

model Executor {
  id String @id @default(uuid())

  name  String 

  tasks Task[]  @relation("task_executors")

  cretedAt DateTime @default(now()) @map("creted_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("executor")

}

model Poster {
  id String @id @default(uuid())

  task Task? @relation()

  cretedAt DateTime @default(now()) @map("creted_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("poster")
}

enum Genre {
  FAST
  SLOW
  MIDDLE

  @@map("enum_genre")
}