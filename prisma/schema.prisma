generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URI")
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  note        Int
  rating      Float      @default(0.0)
  isAvailable Boolean    @default(false) @map("is_available")
  genre       Genre      @default(FAST)
  cretedAt    DateTime   @default(now()) @map("creted_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  posterId    String?     @unique
  reviews     Review[]   @relation("task_reviews")
  poster      Poster?     @relation(fields: [posterId], references: [id])
  executors   Executor[] @relation("task_executors")

  @@map("task")
}

model Review {
  id        String   @id @default(uuid())
  text      String
  taskId    String   @map("task_id")
  cretedAt  DateTime @default(now()) @map("creted_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  task      Task     @relation("task_reviews", fields: [taskId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Executor {
  id        String   @id @default(uuid())
  name      String
  cretedAt  DateTime @default(now()) @map("creted_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tasks     Task[]   @relation("task_executors")

  @@map("executor")
}

model Poster {
  id        String   @id @default(uuid())
  url        String?
  cretedAt  DateTime @default(now()) @map("creted_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  task      Task?

  @@map("poster")
}

enum Genre {
  FAST
  SLOW
  MIDDLE

  @@map("enum_genre")
}
